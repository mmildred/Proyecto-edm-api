generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model logs {
  id         Int      @id @default(autoincrement())
  statusCode Int
  timeStamp  DateTime @default(now())
  path       String   @db.VarChar(200)
  error      String   @db.Text
  errorCode  String   @db.VarChar(200)
  sesion_id  Int?
  user       user?    @relation(fields: [sesion_id], references: [id], map: "Logs_sesion_id_fkey")

  @@index([sesion_id], map: "Logs_sesion_id_fkey")
}

model rol {
  id          Int     @id @default(autoincrement())
  description String  @db.VarChar(200)
  status      Boolean @default(true)
  user        user[]
}

model task {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(250)
  description String   @db.VarChar(200)
  priority    Boolean  @default(false)
  user_id     Int
  created_dt  DateTime @default(now())
  user        user     @relation(fields: [user_id], references: [id], map: "Task_user_id_fkey")

  @@index([user_id], map: "Task_user_id_fkey")
}

model user {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  lastname     String   @db.VarChar(205)
  username     String   @unique(map: "User_username_key") @db.VarChar(150)
  password     String
  refreshToken String?  @db.VarChar(500)
  created_dt   DateTime @default(now())
  hash         String?
  rol_id       Int?     @default(1)
  logs         logs[]
  task         task[]
  rol          rol?     @relation(fields: [rol_id], references: [id], map: "User_rol_id_fkey")
  auditLogs    AuditLog[]

  @@index([rol_id], map: "User_rol_id_fkey")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     
  action    String   
  severity  String   
  ip        String?  
  details   Json?    
  timestamp DateTime @default(now())

  user      user?    @relation(fields: [userId], references: [id])
}